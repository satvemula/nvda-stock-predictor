import os
import sys
import numpy as np
import pandas as pd
from dotenv import load_dotenv
from alpha_vantage.timeseries import TimeSeries
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error
from dash import dcc, html, Dash
import plotly.graph_objs as go

# Load environment variables
load_dotenv()

def fetch_data(symbol='NVDA'):
    """Fetches full daily data from Alpha Vantage."""
    api_key = os.getenv('ALPHA_VANTAGE_KEY')
    if not api_key:
        print("Error: ALPHA_VANTAGE_KEY not found in .env file.")
        sys.exit(1)

    try:
        ts = TimeSeries(key=api_key, output_format='pandas')
        data, _ = ts.get_daily(symbol=symbol, outputsize='full')
        
        # Clean and sort
        data = data[['4. close', '5. volume']]
        data.rename(columns={'4. close': 'Close', '5. volume': 'Volume'}, inplace=True)
        data.index = pd.to_datetime(data.index)
        data.sort_index(inplace=True)
        return data
    except Exception as e:
        print(f"Error fetching data: {e}")
        return pd.DataFrame()

def add_features(df):
    """Generates technical indicators for the model."""
    df = df.copy()
    df['Close_Lag1'] = df['Close'].shift(1)
    df['MA_10'] = df['Close'].rolling(10).mean()
    df['MA_50'] = df['Close'].rolling(50).mean()
    df['Returns'] = df['Close'].pct_change()
    df['Volatility_10'] = df['Returns'].rolling(10).std()
    df['Momentum_3'] = df['Close'] - df['Close'].shift(3)
    df['Volume_Change'] = df['Volume'].pct_change()
    df.dropna(inplace=True)
    return df

def train_model(data):
    """Splits data and trains the Random Forest model."""
    # Dynamic split: 80% train, 20% test
    split_idx = int(len(data) * 0.8)
    train_data = data.iloc[:split_idx]
    test_data = data.iloc[split_idx:]

    features = ['Close_Lag1', 'MA_10', 'MA_50', 'Volume',
                'Volatility_10', 'Momentum_3', 'Volume_Change']
    
    X_train = train_data[features]
    y_train = train_data['Close']
    
    model = RandomForestRegressor(n_estimators=100, random_state=42)
    model.fit(X_train, y_train)
    
    return model, train_data, test_data, features

def run_forecast(model, test_data, features, days=60):
    """Generates future predictions based on the trained model."""
    forecast_data = test_data.copy()
    
    # Calculate start date for forecast (next business day after data ends)
    last_date = forecast_data.index[-1]
    predicted_dates = pd.date_range(start=last_date + pd.Timedelta(days=1), periods=days, freq='B')

    future_rows = []

    # Iterative forecasting
    for date in predicted_dates:
        # Get latest metrics based on the appended forecast_data
        current_tail = forecast_data if not future_rows else pd.concat([forecast_data, pd.DataFrame(future_rows)])
        
        close_lag = current_tail['Close'].iloc[-1]
        ma_10 = current_tail['Close'].tail(10).mean()
        ma_50 = current_tail['Close'].tail(50).mean()
        returns = current_tail['Close'].pct_change().tail(10)
        volatility_10 = returns.std()
        momentum_3 = current_tail['Close'].iloc[-1] - current_tail['Close'].iloc[-4]
        
        # FIX: Use last known volume, not price
        volume = current_tail['Volume'].iloc[-1] 
        volume_change = current_tail['Volume'].pct_change().iloc[-1]

        input_row = pd.DataFrame([{
            'Close_Lag1': close_lag,
            'MA_10': ma_10,
            'MA_50': ma_50,
            'Volume': volume,
            'Volatility_10': volatility_10,
            'Momentum_3': momentum_3,
            'Volume_Change': volume_change
        }])

        pred_close = model.predict(input_row)[0]

        new_row = {
            'Close': pred_close,
            'Volume': volume, # Assuming constant volume for forecast simplicity
            'Close_Lag1': close_lag,
            'MA_10': ma_10,
            'MA_50': ma_50,
            'Returns': 0, # Placeholder
            'Volatility_10': volatility_10,
            'Momentum_3': momentum_3,
            'Volume_Change': volume_change
        }
        future_rows.append(pd.DataFrame(new_row, index=[date]))

    future_df = pd.concat(future_rows)
    return future_df

# --- Main Execution ---
print("Fetching Data...")
raw_data = fetch_data()
if raw_data.empty:
    print("No data found. Exiting.")
    sys.exit()

print("Engineering Features...")
processed_data = add_features(raw_data)

print("Training Model...")
model, train_data, test_data, features = train_model(processed_data)

# Calculate MAE on Test Data
y_test = test_data['Close']
test_preds = model.predict(test_data[features])
mae = mean_absolute_error(y_test, test_preds)
print(f"Model MAE: {mae:.2f}")

print("Forecasting Future...")
future_df = run_forecast(model, test_data, features, days=60)

# Generate Candlestick Simulation for Visual Flair
future_candle = future_df.copy()
future_candle['Open'] = future_candle['Close'].shift(1).fillna(future_candle['Close'])
future_candle['High'] = future_candle['Close'] * 1.02
future_candle['Low'] = future_candle['Close'] * 0.98

# --- Dash App Layout ---
app = Dash(__name__)
app.title = "NVDA Stock AI Forecast"

line_chart = go.Scatter(
    x=test_data.index, y=test_data['Close'],
    mode='lines', name='Actual History (Test Set)', line=dict(color='#1f77b4')
)

forecast_line = go.Scatter(
    x=future_df.index, y=future_df['Close'],
    mode='lines', name='AI Forecast (60 Days)', line=dict(color='#ff7f0e', dash='dot')
)

candlestick = go.Candlestick(
    x=future_candle.index,
    open=future_candle['Open'], high=future_candle['High'],
    low=future_candle['Low'], close=future_candle['Close'],
    name="Simulated Future Range"
)

app.layout = html.Div([
    html.H1("NVIDIA Stock Price Predictor", style={'textAlign': 'center'}),
    html.Div([
        html.H3(f"Model Accuracy (MAE): ${mae:.2f}", style={'color': 'darkgray'}),
        html.P("Note: This model uses a Random Forest Regressor on lagging technical indicators."),
    ], style={'textAlign': 'center', 'marginBottom': '30px'}),

    dcc.Tabs([
        dcc.Tab(label='Trend Analysis', children=[
            dcc.Graph(figure={
                'data': [line_chart, forecast_line],
                'layout': go.Layout(title="Price Trajectory", template="plotly_white")
            })
        ]),
        dcc.Tab(label='Forecast Simulation', children=[
            dcc.Graph(figure={
                'data': [candlestick],
                'layout': go.Layout(title="60-Day Simulated Candle Forecast", template="plotly_white")
            })
        ])
    ])
], style={'fontFamily': 'Arial, sans-serif', 'maxWidth': '1000px', 'margin': '0 auto'})

if __name__ == '__main__':
    app.run_server(debug=True, port=8051)
